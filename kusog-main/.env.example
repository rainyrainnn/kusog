VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Raspberry Pi host/IP; used by the rain sensor (5001) and YOLO service (5002).
# If omitted, the host is derived from VITE_KUSOG_EDGE_URL.
VITE_KUSOG_PI_HOST=YOUR_RASPBERRY_PI_IP

# Raspberry Pi Tuya rain API endpoint.
VITE_KUSOG_RAIN_URL=http://YOUR_RASPBERRY_PI_IP:5001/api/rain

# Raspberry Pi YOLO API (port 5002)
VITE_KUSOG_EDGE_URL=http://YOUR_RASPBERRY_PI_IP:5002

# Existing camera stream URL
# VITE_KUSOG_CAMERA_URL=http://YOUR_RASPBERRY_PI_IP:5002/video