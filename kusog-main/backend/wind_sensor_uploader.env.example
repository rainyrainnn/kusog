# Fill the serial and register settings from the UMini-WS manual/configuration.
# The UMini-WS is read-only here; this uploader sends no control commands.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_ON_PI_ONLY

WIND_RS485_PORT=/dev/ttyUSB0
WIND_MODBUS_BAUDRATE=SET_FROM_SENSOR_MANUAL
WIND_MODBUS_SLAVE_ID=SET_FROM_SENSOR_CONFIG
WIND_REGISTER_TYPE=SET_TO_holding_OR_input
WIND_SPEED_REGISTER=SET_REGISTER_ADDRESS
WIND_DIRECTION_REGISTER=SET_REGISTER_ADDRESS
WIND_SPEED_FORMAT=SET_u16_s16_u32_s32_OR_f32
WIND_DIRECTION_FORMAT=SET_u16_s16_u32_s32_OR_f32
WIND_SPEED_SCALE_MPS=SET_SCALE_FROM_MANUAL
WIND_DIRECTION_SCALE_DEG=SET_SCALE_FROM_MANUAL

# Confirm these serial settings against the sensor configuration.
WIND_MODBUS_PARITY=N
WIND_MODBUS_STOPBITS=1
WIND_MODBUS_BYTE_SIZE=8
WIND_WORD_ORDER=big
WIND_SERIAL_TIMEOUT_SECONDS=2
WIND_UPLOAD_INTERVAL_SECONDS=1