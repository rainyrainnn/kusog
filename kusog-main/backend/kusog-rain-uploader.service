[Unit]
Description=KUSOG physical rain sensor Supabase uploader

[Service]
Type=simple
WorkingDirectory=%h/kusog-rain
EnvironmentFile=%h/.config/kusog-rain-uploader.env
ExecStart=/usr/bin/python3 %h/kusog-rain/backend/rain_sensor_uploader.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
