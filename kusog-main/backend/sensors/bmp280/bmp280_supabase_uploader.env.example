# Install as /home/chamber-pi/.config/kusog/bmp280.env on chamber-pi.
# Install adafruit-circuitpython-bmp280 in ~/yolo-env before running the uploader.
# The device token is not a Supabase service_role key; never put service credentials on the Pi.
BMP280_UPLOAD_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/bmp280-upload
BMP280_DEVICE_TOKEN=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
BMP280_UPLOAD_INTERVAL_SECONDS=5
