HX711_UPLOAD_URL=https://gqkxingmxbjsmkwbnpko.supabase.co/functions/v1/hx711-upload
HX711_DEVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Physical pins 29 and 31 map to BCM GPIO 5 (DT/DOUT) and BCM GPIO 6 (SCK/CLK).
HX711_DT_GPIO=5
HX711_SCK_GPIO=6

# Leave unset until calibrated with a known weight and the correct tare procedure.
# HX711_CALIBRATION_FACTOR=
HX711_ZERO_THRESHOLD_GRAMS=0
HX711_SAMPLE_COUNT=5
HX711_TARE_SAMPLE_COUNT=20
HX711_UPLOAD_INTERVAL_SECONDS=5
