VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Raspberry Pi KUSOG edge server
# Run backend/yolo_server.py on the Pi (port 5000) and set its camera/model inputs there.
VITE_KUSOG_EDGE_URL=http://YOUR_RASPBERRY_PI_IP:5000

# Optional camera URL override; by default the app uses the edge server's /camera stream
# VITE_KUSOG_CAMERA_URL=http://YOUR_RASPBERRY_PI_IP:5000/camera